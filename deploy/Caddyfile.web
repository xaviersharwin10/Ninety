# The web half of a two-service deployment. Pages come from the web app here; match data and the
# quote relay live in the other service, and are passed through so the browser still sees one address.
{
	admin off
	auto_https off
	# The host's own proxy sits in front, on a private address. Without trusting it, Caddy replaces
	# X-Forwarded-For with that proxy's address, and every visitor looks like the same one: the gas
	# sponsor's per-visitor limits then applied to all visitors together.
	servers {
		trusted_proxies static private_ranges
	}
}

:{$PORT:10000} {
	@backend path /md/* /relay/*
	handle @backend {
		reverse_proxy {$BACKEND_URL} {
			header_up Host {upstream_hostport}
		}
	}
	handle {
		reverse_proxy 127.0.0.1:3000
	}
}
