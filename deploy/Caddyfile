# One public address for the hosted app. Match data and the quote relay each keep their own port
# inside the container; the browser reaches them under a path, WebSockets included.
{
	admin off
	auto_https off
	# The host's own proxy sits in front, on a private address. Without trusting it, Caddy replaces
	# X-Forwarded-For with that proxy's address, and every visitor looks like the same one: the gas
	# sponsor's per-visitor limits then applied to all visitors together.
	servers {
		trusted_proxies static private_ranges
	}
}

:{$PORT:10000} {
	handle_path /md/* {
		reverse_proxy 127.0.0.1:8082
	}
	handle_path /relay/* {
		reverse_proxy 127.0.0.1:8081
	}
	handle {
		reverse_proxy 127.0.0.1:3000
	}
}
