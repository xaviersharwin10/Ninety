# --- private planning context: never published ---
CLAUDE.md

# --- secrets ---
.env
.env.*
!.env.example
secrets.yaml
*.pem
*.key

# --- node ---
node_modules/
.pnpm-store/
*.tsbuildinfo
.turbo/

# --- foundry ---
contracts/out/
contracts/cache/
# Foundry's own verbose per-run transaction log. deployments/<chainid>.json is the curated,
# hand-verified record of what's actually deployed -- see the repo layout notes in the plan.
# Keeping raw broadcast/ out of git means a local rehearsal (e.g. against a forked RPC using the
# real chain ID) can never be mistaken for a real deployment record.
contracts/broadcast/
contracts/.gas-snapshot.tmp

# --- next.js / vercel ---
web/.next/
web/out/
.vercel/

# --- envio ---
indexer/generated/
indexer/.envio/
indexer/db/

# --- chainlink cre ---
cre/**/dist/
cre/**/*.wasm
cre/.cre/

# --- match data (fetched at runtime, not vendored) ---
packages/match-data/data/raw/

# --- misc ---
.DS_Store
*.log
coverage/
lcov.info
