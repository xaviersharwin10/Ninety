# Public settings baked into the hosted web build. Nothing secret: contract addresses are in
# deployments/10143.json too. Match data and the quote relay sit under the app's own address
# (see deploy/Caddyfile and web/lib/service-url.ts), so the build works on any hostname, and
# NEXT_PUBLIC_RP_ID stays empty so passkeys bind to whatever hostname serves it.
NEXT_PUBLIC_RP_ID=
NEXT_PUBLIC_APP_NAME=Ninety
NEXT_PUBLIC_CHAIN_ID=10143
NEXT_PUBLIC_RPC_URL=https://testnet-rpc.monad.xyz
NEXT_PUBLIC_MATCH_DATA_URL=/md
NEXT_PUBLIC_MATCH_DATA_WS_URL=/md/ws
NEXT_PUBLIC_RELAY_WS_URL=/relay
NEXT_PUBLIC_NUSD_ADDRESS=0x85fe9D32c8B5c02639767399D7DCA585042ea57b
NEXT_PUBLIC_AGENT_REGISTRY=0xdbE23698776e12A7e1bf5FFBe5054d6919BcA8df
NEXT_PUBLIC_MARKET_MANAGER=0x7CB80d9De72273db78e013Fdb2180023A9152b88
NEXT_PUBLIC_BET_ROUTER=0xd368165544A427d1d42FCF53846fA84c37cBB387
NEXT_PUBLIC_SETTLEMENT_RECEIVER=0xc00496c616EaA9f4B7fC59F68D0B461AFF16D5d9
NEXT_PUBLIC_AGENT_MEMORY=0xB07D8e5B822F0d885BcDEebE3Dceb2166FF5D85c
NEXT_PUBLIC_ODDS_LOCK=0xee2F9187af4266190C0F44CDbf8BA67650A2b072
# The hosted instances are small: a slower replay gives each market time to be priced and bet on.
NEXT_PUBLIC_REPLAY_SPEED=2
