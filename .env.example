# =============================================================================
# Ninety — environment template. Copy to .env and fill in.
# NEVER commit .env. Every variable used anywhere in the repo is listed here.
# =============================================================================

# --- Monad testnet ---------------------------------------------------------
MONAD_CHAIN_ID=10143
MONAD_RPC_URL=https://testnet-rpc.monad.xyz
MONAD_EXPLORER_URL=https://testnet.monadexplorer.com

# --- Stablecoin: NinetyUSD (nUSD), our own 6-decimal testnet token --------
# Deployed by contracts/script/Deploy.s.sol. Its faucet is built in: claim() mints 1,000 nUSD
# once per hour per address, so it cannot run dry. See contracts/src/NinetyUSD.sol.
NUSD_ADDRESS=0x85fe9D32c8B5c02639767399D7DCA585042ea57b

# --- Deployer / operator keys (testnet only, never reuse elsewhere) ---------
DEPLOYER_PRIVATE_KEY=
SCHEDULER_PRIVATE_KEY=
# Funds brand-new passkey accounts with a little MON so their first tx lands.
# This is a gas relayer, NOT custody: it never holds user keys or user funds.
# 0.5 MON, not less: Monad bills gas on a tx's gas_limit, not gas actually used, so the sender
# needs gas_limit * maxFeePerGas available *before* the tx lands, not just the real cost. Confirmed
# directly: AgentRegistry.register() (deploys a new AgentVault) carries a ~2.1M gas_limit, which
# alone reserves ~0.39 MON at current testnet fees even though it uses far less.
GAS_DRIP_PRIVATE_KEY=
GAS_DRIP_AMOUNT_WEI=500000000000000000

# --- Chainlink CRE ---------------------------------------------------------
# Production KeystoneForwarder on monad-testnet. Verifies DON signatures.
CRE_PRODUCTION_FORWARDER=0xF8344CFd5c43616a4366C34E3EEE75af79a74482
# MockKeystoneForwarder used by `cre workflow simulate --broadcast`.
# WARNING: performs NO signature verification and passes attacker-controlled
# workflow metadata straight through. Kept behind an admin toggle that is OFF
# by default and permanently removable via lockProduction(). See README.
CRE_SIMULATION_FORWARDER=0xB9F79d863261869B234c481D1f9A7af84AeAd192
# Signs report payloads while the simulation path is enabled, so a forged
# report through the mock forwarder cannot resolve markets.
CRE_SIM_ATTESTOR_PRIVATE_KEY=
# Registering a workflow writes to the WorkflowRegistry on ETHEREUM MAINNET.
CRE_ETH_PRIVATE_KEY=
CRE_ETH_RPC_URL=

# --- Envio -----------------------------------------------------------------
# Required: HyperSync/HyperRPC reject untokened requests with HTTP 401.
ENVIO_API_TOKEN=
HYPERSYNC_URL=https://monad-testnet.hypersync.xyz
HYPERRPC_URL=https://monad-testnet.rpc.hypersync.xyz

# --- Match data ------------------------------------------------------------
# Wyscout / Pappalardo & Massucco, "Soccer match event dataset", CC BY 4.0.
MATCH_DATA_PORT=8082
MATCH_DATA_URL=http://localhost:8082
WYSCOUT_MIRROR_BASE=https://raw.githubusercontent.com/koenvo/wyscout-soccer-match-event-dataset/main/processed-v2/files
REPLAY_SPEED=1

# --- Quote relay -----------------------------------------------------------
QUOTE_RELAY_PORT=8081
QUOTE_RELAY_WS_URL=ws://localhost:8081

# --- House agents (quote-signing keys; derived from the dev passkey in the
#     browser and handed to the runner as a short-lived session in the demo) --
AGENT_STEADY_PRIVATE_KEY=
AGENT_TEMPO_PRIVATE_KEY=
AGENT_PULSE_PRIVATE_KEY=

# --- Web app (NEXT_PUBLIC_* are exposed to the browser) --------------------
# Mera relying-party ID. Passkeys bind to this domain. DO NOT CHANGE once set.
NEXT_PUBLIC_RP_ID=
NEXT_PUBLIC_APP_NAME=Ninety
NEXT_PUBLIC_CHAIN_ID=10143
NEXT_PUBLIC_RPC_URL=https://testnet-rpc.monad.xyz
# http://localhost:8080/v1/graphql for `cd indexer && pnpm dev`; a hosted Envio Cloud URL in prod.
NEXT_PUBLIC_INDEXER_URL=
NEXT_PUBLIC_MATCH_DATA_URL=http://localhost:8082
NEXT_PUBLIC_MATCH_DATA_WS_URL=ws://localhost:8082/ws
NEXT_PUBLIC_RELAY_WS_URL=ws://localhost:8081
NEXT_PUBLIC_NUSD_ADDRESS=0x85fe9D32c8B5c02639767399D7DCA585042ea57b

# --- Deployed contract addresses (filled by script/Deploy.s.sol) -----------
NEXT_PUBLIC_AGENT_REGISTRY=0xdbE23698776e12A7e1bf5FFBe5054d6919BcA8df
NEXT_PUBLIC_MARKET_MANAGER=0x7CB80d9De72273db78e013Fdb2180023A9152b88
NEXT_PUBLIC_BET_ROUTER=0xd368165544A427d1d42FCF53846fA84c37cBB387
NEXT_PUBLIC_SETTLEMENT_RECEIVER=0xc00496c616EaA9f4B7fC59F68D0B461AFF16D5d9
